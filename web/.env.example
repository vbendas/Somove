# =============================================================================
# Somove Development Environment Variables
# =============================================================================
# Get your Supabase keys from: https://supabase.com/dashboard/project/_/settings/api
# =============================================================================

# --- REQUIRED: Supabase (eu-west-1 Frankfurt) ---
NEXT_PUBLIC_SUPABASE_URL=your-project-url-here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- REQUIRED: Site URL (for magic link redirects) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- OPTIONAL: Cal.com Webhook Secret (for verifying webhook signatures) ---
# Get this when you create the webhook in Cal.com dashboard
CAL_WEBHOOK_SECRET=your-cal-webhook-secret-here
