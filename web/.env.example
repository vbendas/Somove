# =============================================================================
# Somove Development Environment Variables
# =============================================================================
# Get your Supabase keys from: https://supabase.com/dashboard/project/_/settings/api
# =============================================================================

# --- REQUIRED: Supabase (eu-west-1 Frankfurt) ---
NEXT_PUBLIC_SUPABASE_URL=your-project-url-here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- REQUIRED: Site URL (for magic link redirects) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- OPTIONAL: Cal.com Webhook Secret (for verifying webhook signatures) ---
# Get this when you create the webhook in Cal.com dashboard
CAL_WEBHOOK_SECRET=your-cal-webhook-secret-here

# --- OPTIONAL: Daily.co (free hosted video, 2000 min/mo) ---
# Get from https://dashboard.daily.co
DAILY_API_KEY=your-daily-api-key-here
DAILY_DOMAIN=somove

# --- OPTIONAL: MiroTalk P2P (self-hosted video calls) ---
# Get from your MiroTalk instance .env file (API_KEY_SECRET)
MIROTALK_URL=https://video.somove.app
MIROTALK_API_KEY=your-mirotalk-api-key-here

# --- OPTIONAL: Resend (email notifications) ---
# Get from https://resend.com/api-keys
RESEND_API_KEY=re_your-resend-api-key-here

# --- REQUIRED for production: Stripe Connect ---
# Platform Stripe account (Somove business account)
STRIPE_SECRET_KEY=sk_live_xxxxx
STRIPE_PUBLISHABLE_KEY=pk_live_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# --- OPTIONAL: Chatwoot Support Widget ---
# Get from your Chatwoot instance settings
NEXT_PUBLIC_CHATWOOT_WEBSITE_TOKEN=your-chatwoot-website-token
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_API_TOKEN=your-chatwoot-api-token
CHATWOOT_BASE_URL=https://support.somove.app

# --- OPTIONAL: Typebot + OpenRouter (AI triage) ---
# Get from https://typebot.io and https://openrouter.ai
NEXT_PUBLIC_TYPEBOT_BASE_URL=https://bot.somove.app
TYPEBOT_API_TOKEN=your-typebot-api-token
OPENROUTER_API_KEY=your-openrouter-api-key

# --- OPTIONAL: Web Push (VAPID keys) ---
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:hello@somove.app

# --- REQUIRED: Cron secret (protects /api/cron/* from unauthenticated calls) ---
# Generate with: openssl rand -hex 32
CRON_SECRET=your-cron-secret

