# =============================================================================
# Somove — Self-Hosted .env Template
# =============================================================================
# Copy this to .env and fill in your values.
# Or run: bash scripts/generate-keys.sh (generates all secrets automatically)
# =============================================================================

# --- REQUIRED: Supabase ---
POSTGRES_PASSWORD=change-me-to-a-secure-password
JWT_SECRET=change-me-to-a-64-char-random-string
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
POSTGRES_DB=postgres

# --- REQUIRED: Site ---
SITE_URL=http://localhost:3000
APP_PORT=3000
DB_PORT=5432
API_PORT=8000

# --- OPTIONAL: Stripe Connect ---
STRIPE_SECRET_KEY=sk_live_xxxxx
STRIPE_PUBLISHABLE_KEY=pk_live_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# --- OPTIONAL: Daily.co (free hosted video, 2000 min/mo) ---
DAILY_API_KEY=your-daily-api-key
DAILY_DOMAIN=somove

# --- OPTIONAL: MiroTalk P2P (self-hosted video calls) ---
MIROTALK_URL=https://video.yourdomain.com
MIROTALK_API_KEY=your-mirotalk-api-key

# --- OPTIONAL: Resend (email notifications) ---
RESEND_API_KEY=re_your-resend-api-key

# --- OPTIONAL: Chatwoot Support Widget ---
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_API_TOKEN=your-chatwoot-api-token
CHATWOOT_BASE_URL=https://support.yourdomain.com
CHATWOOT_WEBSITE_TOKEN=your-chatwoot-website-token

# --- OPTIONAL: Web Push (VAPID) ---
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key

# --- OPTIONAL: Cron secret (for session reminders) ---
CRON_SECRET=your-cron-secret

# --- Dashboard (Supabase Studio) ---
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=change-this-password
